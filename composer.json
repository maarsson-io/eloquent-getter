{
    "name": "maarsson/eloquent-getter",
    "description": "An Eloquent getter/filter/sorter pattern for Laravel",
    "type": "package",
    "license": "MIT",
    "authors": [
        {
            "name": "VMaarsson",
            "email": "viktor@maarsson.se"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "phpmd/phpmd": "^2.15",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Maarsson\\EloquentGetter\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maarsson\\EloquentGetter\\Providers\\EloquentGetterServiceProvider"
            ]
        }
    },
    "scripts": {
        "ci:phpcs": "phpcs --standard=.phpcs.xml src config",
        "ci:phpmd": "phpmd src,config text phpmd.xml",
        "ci:php-cs-fixer": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php"
    }
}
